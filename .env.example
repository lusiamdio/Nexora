# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Supabase Authentication & Database Integration
Supabase_project_url="https://YOUR_PROJECT_ID.supabase.co"
Supabase_anon_key="YOUR_SUPABASE_ANON_KEY"
Supabase_publishable_key="YOUR_SUPABASE_PUBLISHABLE_KEY"
Supabase_project_id="YOUR_PROJECT_ID"
VITE_SUPABASE_URL="https://YOUR_PROJECT_ID.supabase.co"
VITE_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"

# Super Admin Security & Session Signing (Server-side only - never expose with VITE_)
SUPERADMIN_PASSKEY="CHANGE_ME_STRONG_PASSKEY"
ADMIN_SESSION_SECRET="CHANGE_ME_AT_LEAST_32_CHARS_RANDOM_SECRET"

# Google Maps Platform (Client SDK key; restrict to HTTP referrers in production)
VITE_GOOGLE_MAPS_API_KEY="MY_GOOGLE_MAPS_API_KEY"

# OpenAI Platform & Webhook Verification (Server-side only - never prefix with VITE_)
OPENAI_API_KEY=
OPENAI_PROJECT_ID=
OPENAI_WEBHOOK_SECRET=

# Alchemy Web3 APIs, Gas Sponsorship & Webhooks (Server-side only - never prefix with VITE_)
ALCHEMY_API_KEY=
ALCHEMY_GAS_POLICY_ID=
ALCHEMY_WEBHOOK_ID=
ALCHEMY_WEBHOOK_SIGNING_KEY=

# MailerLite Email Marketing & Subscriber Sync (Server-side only - never prefix with VITE_)
MAILERLITE_API_TOKEN=

