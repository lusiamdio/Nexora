# Copy to .env for local development. Keep secrets out of version control.
# Public browser configuration (use a publishable/anon key, never a service-role key).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_SUPABASE_PROJECT_ID=

# Optional server-side integrations.
GEMINI_API_KEY=
PAYSTACK_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
FLUTTERWAVE_SECRET_HASH=
# Enables the process-local configuration rotation endpoint when set.
ADMIN_ROTATION_PASSKEY=
PORT=3000
